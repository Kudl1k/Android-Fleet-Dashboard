      "transformations": [
        {
          "id": "merge",
          "options": {}
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true,
              "Value #B": true,
              "instance": true,
              "job": true,
              "__name__": true,
              "kernel": true,
              "manufacturer": true
            },
            "indexByName": {
              "device_id": 0,
              "Value #A": 1,
              "manufacturer": 2,
              "model": 3,
              "android_version": 4,
              "soc": 5,
              "Value #H": 6,
              "Value #C": 7,
              "Value #D": 8,
              "Value #E": 9,
              "Value #F": 10,
              "Value #G": 11
            },
            "renameByName": {
              "device_id": "Device",
              "Value #A": "Status",
              "manufacturer": "Manufacturer",
              "model": "Model",
              "android_version": "Android",
              "soc": "SoC",
              "Value #H": "Root",
              "Value #C": "CPU",
              "Value #D": "RAM",
              "Value #E": "Battery",
              "Value #F": "Max temp",
