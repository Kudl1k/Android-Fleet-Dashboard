{
  "uid": "android-fleet-overview",
  "title": "Android Fleet Overview",
  "schemaVersion": 40,
  "version": 1,
  "editable": true,
  "tags": [
    "android-fleet"
  ],
  "timezone": "browser",
  "refresh": "30s",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "panels": [
    {
      "id": 100,
      "title": "Fleet status (current)",
      "type": "table",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 7
      },
      "targets": [
        {
          "refId": "A",
          "expr": "max by (device_id) (android_device_up)",
          "legendFormat": "",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "instant": true,
          "format": "table"
        },
        {
          "refId": "B",
          "expr": "max by (device_id, manufacturer, model, android_version, soc) (android_device_info)",
          "legendFormat": "",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "instant": true,
          "format": "table"
        },
        {
          "refId": "C",
          "expr": "max by (device_id) (last_over_time(android_cpu_usage_ratio[2m]))",
          "legendFormat": "",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "instant": true,
          "format": "table"
        },
        {
          "refId": "D",
          "expr": "max by (device_id) (android_memory_used_bytes / android_memory_total_bytes)",
          "legendFormat": "",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "instant": true,
          "format": "table"
        },
        {
          "refId": "E",
          "expr": "max by (device_id) (android_battery_level_ratio)",
          "legendFormat": "",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "instant": true,
          "format": "table"
        },
        {
          "refId": "F",
          "expr": "max by (device_id) (android_temperature_celsius)",
          "legendFormat": "",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "instant": true,
          "format": "table"
        },
        {
          "refId": "G",
          "expr": "max by (device_id) (android_cpu_frequency_capped)",
          "legendFormat": "",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "instant": true,
          "format": "table"
        },
        {
          "refId": "H",
          "expr": "max by (device_id) (android_device_rooted)",
          "legendFormat": "",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "instant": true,
          "format": "table"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none"
        },
        "overrides": [
