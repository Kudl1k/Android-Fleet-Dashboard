{
  "uid": "android-fleet-device",
  "title": "Android Device Detail",
  "schemaVersion": 40,
  "version": 1,
  "editable": true,
  "tags": [
    "android-fleet"
  ],
  "timezone": "browser",
  "refresh": "30s",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "panels": [
    {
      "id": 1,
      "title": "Availability",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "android_device_up{device_id=~\"$device\"}",
          "legendFormat": "{{device_id}} {{core}} {{sensor}} {{type}} {{mount}}",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "bool",
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "linear",
            "showPoints": "never"
          }
        },
        "overrides": []
      },
      "options": {
        "tooltip": {
          "mode": "multi"
        },
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      }
    },
