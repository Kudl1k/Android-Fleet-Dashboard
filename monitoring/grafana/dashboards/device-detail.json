        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "android_device_up{device_id=~\"$device\"}",
          "legendFormat": "{{device_id}} {{core}} {{sensor}} {{type}} {{mount}}",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "bool",
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "linear",
            "showPoints": "never"
          }
        },
        "overrides": []
      },
      "options": {
        "tooltip": {
          "mode": "multi"
        },
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      }
    },
