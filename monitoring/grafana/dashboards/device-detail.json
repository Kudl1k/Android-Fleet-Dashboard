{
  "uid": "android-fleet-device",
  "title": "Android Device Detail",
  "schemaVersion": 40,
  "version": 1,
  "editable": true,
  "tags": [
    "android-fleet"
  ],
  "timezone": "browser",
  "refresh": "30s",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "panels": [
    {
      "id": 100,
      "title": "Device",
      "type": "table",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 4
      },
      "targets": [
        {
          "refId": "A",
          "expr": "max by (device_id, manufacturer, model, android_version, soc, kernel) (android_device_info{device_id=~\"$device\"})",
          "legendFormat": "",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "instant": true,
          "format": "table"
        },
        {
          "refId": "B",
          "expr": "max by (device_id) (android_device_rooted{device_id=~\"$device\"})",
          "legendFormat": "",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "instant": true,
          "format": "table"
        },
        {
          "refId": "C",
          "expr": "max by (device_id) (android_uptime_seconds{device_id=~\"$device\"})",
          "legendFormat": "",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "instant": true,
          "format": "table"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none"
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Root"
            },
            "properties": [
              {
                "id": "mappings",
                "value": [
                  {
                    "type": "value",
                    "options": {
                      "1": {
                        "text": "yes",
                        "color": "green",
                        "index": 0
                      },
                      "0": {
                        "text": "no",
                        "color": "text",
                        "index": 1
                      }
                    }
                  }
                ]
              },
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-text"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Uptime"
            },
            "properties": [
              {
                "id": "unit",
                "value": "s"
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm"
      },
      "transformations": [
        {
          "id": "merge",
          "options": {}
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true,
              "Value #A": true,
              "instance": true,
              "job": true,
              "__name__": true
            },
            "indexByName": {
              "device_id": 0,
              "manufacturer": 1,
              "model": 2,
              "android_version": 3,
              "soc": 4,
              "kernel": 5,
              "Value #B": 6,
              "Value #C": 7
            },
            "renameByName": {
              "device_id": "Device",
              "manufacturer": "Manufacturer",
              "model": "Model",
              "android_version": "Android",
              "soc": "SoC",
              "kernel": "Kernel",
              "Value #B": "Root",
              "Value #C": "Uptime"
            }
          }
        }
      ]
    },
    {
      "id": 1,
      "title": "Availability",
      "type": "timeseries",
