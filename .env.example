# Fake mode never contacts Android hardware. Disable for real network devices.
ANDROID_FLEET_FAKE_ADB=true
# Populate the four demo USB identities only when fake registry is initially empty.
ANDROID_FLEET_SEED_FAKE_DEVICES=true
ANDROID_FLEET_POLL_INTERVAL=15
# Compose fixes database path in its private persistent device-registry volume.
# Local native runs can export this override (default data/devices.sqlite3):
ANDROID_FLEET_REGISTRY_PATH=data/devices.sqlite3
# Optional server-side mDNS; multicast may not cross Docker/Colima bridges.
ANDROID_FLEET_MDNS=false
ANDROID_FLEET_CONNECT_TIMEOUT=10
ANDROID_FLEET_BACKOFF_INITIAL=2
ANDROID_FLEET_BACKOFF_MAX=60
# Set a strong random value for connectivity/configuration mutations over Docker HTTP.
# Generate locally: python -c 'import secrets; print(secrets.token_urlsafe(32))'
# Blank denies all mutations; loopback access never grants control permissions.
ANDROID_FLEET_CONTROL_TOKEN=
# Empty host uses container-local ADB server; never publish port 5037.
ADB_SERVER_HOST=
ADB_SERVER_PORT=5037
GRAFANA_ADMIN_PASSWORD=replace-this-local-development-password

# Independent monitoring cadence, bounded command/cycle budgets and fleet parallelism.
ANDROID_FLEET_METRICS_INTERVAL=15
ANDROID_FLEET_METRICS_COMMAND_TIMEOUT=5
ANDROID_FLEET_METRICS_CYCLE_TIMEOUT=20
ANDROID_FLEET_METRICS_PARALLEL_DEVICES=4
ANDROID_FLEET_METRICS_MAX_AGE=90
ANDROID_FLEET_CAPABILITY_REFRESH_INTERVAL=300
# Separate history database; Compose uses the existing private registry volume.
ANDROID_FLEET_HISTORY_PATH=data/metrics.sqlite3
ANDROID_FLEET_HISTORY_RETENTION_SECONDS=604800
ANDROID_FLEET_HISTORY_MAX_POINTS=1000000

# M3 dashboard (loopback only) and server-owned alert evaluation.
ANDROID_FLEET_FRONTEND_PORT=8088
# Compose fixes this to /var/lib/android-fleet/alerts.sqlite3; native default is
# alerts.sqlite3 beside the registry (an in-memory registry gets in-memory alerts).
ANDROID_FLEET_ALERTS_PATH=data/alerts.sqlite3
ANDROID_FLEET_ALERTS_INTERVAL=5

# M4 named credentials: JSON [{"identity":"alice","role":"operator","token_hash":"<sha256>"}]
# Generate high entropy tokens and SHA256 hashes privately; never put tokens in source.
ANDROID_FLEET_RBAC_CREDENTIALS=
# Fleet data requires credentials by default. Explicit true permits anonymous viewer reads.
ANDROID_FLEET_ANONYMOUS_VIEWER=false
ANDROID_FLEET_AUDIT_RETENTION_SECONDS=7776000
ANDROID_FLEET_OPERATIONS_CONCURRENCY=4
ANDROID_FLEET_OPERATIONS_MAX_QUEUED=100
ANDROID_FLEET_OPERATIONS_TIMEOUT_SECONDS=30
ANDROID_FLEET_APK_MAX_BYTES=67108864
ANDROID_FLEET_SCREENSHOT_MAX_BYTES=16777216
ANDROID_FLEET_SCREENSHOT_RETENTION_SECONDS=3600
# M5 screen streaming; keep the origin list limited to trusted dashboard origins.
ANDROID_FLEET_SCREEN_MAX_SESSIONS=4
ANDROID_FLEET_SCREEN_MAX_PER_DEVICE=2
ANDROID_FLEET_SCREEN_MAX_PER_USER=2
ANDROID_FLEET_SCREEN_IDLE_SECONDS=30
ANDROID_FLEET_SCREEN_ALLOWED_ORIGINS=["http://127.0.0.1:8088","http://localhost:8088"]
ANDROID_FLEET_ALERTS_RETENTION_SECONDS=2592000

# JSON per-operation timeout overrides, e.g. {"apps.install":120}
ANDROID_FLEET_OPERATIONS_TIMEOUTS={}

# M7: disabled/default-deny; never commit the separately managed Fernet key.
ANDROID_FLEET_TERMINAL_ADB_ENABLED=false
ANDROID_FLEET_SSH_ENCRYPTION_KEY=
ANDROID_FLEET_SSH_DESTINATIONS=[]
# Optional first-start seed; administrators can manage approvals in Device management.
ANDROID_FLEET_PAIRING_ALLOWED_HOSTS=[]
ANDROID_FLEET_TERMINAL_MAX_SESSIONS=16
ANDROID_FLEET_TERMINAL_MAX_PER_USER=4
ANDROID_FLEET_TERMINAL_MAX_PER_DEVICE=2
ANDROID_FLEET_TERMINAL_IDLE_SECONDS=300
ANDROID_FLEET_TERMINAL_LIFETIME_SECONDS=3600
